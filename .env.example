# WADR environment — copy to .env and adjust
# See docs/configuration.md for details

WADR_DATABASE_URL=postgresql://wadr:wadr@localhost:5433/wadr
WADR_OLLAMA_URL=http://127.0.0.1:11434
WADR_EMBED_MODEL=nomic-embed-text
WADR_OPENWA_BRIDGE_URL=http://127.0.0.1:8085
WADR_API=http://localhost:8000
# Bridge port (bridge/index.js reads PORT)
PORT=8085
